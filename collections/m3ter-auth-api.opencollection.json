{
  "opencollection": "1.0.0",
  "info": {
    "name": "m3ter Account Auth API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Auth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.m3ter.com/oauth/token",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Get authentication token"
        }
      ]
    }
  ],
  "bundled": true
}