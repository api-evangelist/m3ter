{
  "opencollection": "1.0.0",
  "info": {
    "name": "m3ter Account User API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "User",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve current user information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.m3ter.com/organizations/:orgId/users/me",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path",
                "description": "UUID of the organization.\nThe Organization represents your company as a direct customer of the m3ter service. "
              }
            ]
          },
          "docs": "Retrieve information about the current user"
        }
      ]
    }
  ],
  "bundled": true
}